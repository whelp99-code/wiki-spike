{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wiki-spike.local/schemas/encrypted-lifecycle/encrypted-accepted-changeset-v1.schema.json",
  "title": "Encrypted Lifecycle EncryptedAcceptedChangeSetV1 (Revision 6/7 frozen)",
  "description": "EncryptedAcceptedChangeSetV1 remains exactly {contract_version,changeset_id,workspace_id,parent_generation_id,expected_active_revisions,command_ids,deltas,changes_root}. `expected_active_revisions` is the sorted-unique projection of every embedded delta's six-key ExpectedActiveRevisionV1 element {object_kind,object_id,assertion_id,evidence_edge_id,evidence_fragment_ref,expected_active_revision_id}, sorted by (object_kind UTF-8 bytes, object_id bytes) with literal nulls by object kind; duplicate target with unequal expectation, or unequal owner-wide expectation, rejects `conflicting_expected_active_revision` before hashing. `command_ids` and delta identities inside `deltas` are sorted/unique. `changes_root = SHA-256(\"wiki.changes-root.v1\" || length-delimited canonical delta bytes in canonical order)`. `changeset_id = SHA-256(\"wiki.encrypted-accepted-change-set.v1\" || canonical bytes of all fields except changeset_id)`.",
  "definitions": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableHex64": {"oneOf": [{"$ref": "#/definitions/hex64"}, {"type": "null"}]},
    "opaqueId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
    "safeReasonCode": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        {"type": "null"}
      ]
    },
    "expectedActiveRevisionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_kind", "object_id", "assertion_id", "evidence_edge_id", "evidence_fragment_ref", "expected_active_revision_id"],
      "properties": {
        "object_kind": {"enum": ["MEMORY_REVISION", "EVIDENCE_FRAGMENT", "ASSERTION", "EVIDENCE_EDGE"]},
        "object_id": {"$ref": "#/definitions/hex64"},
        "assertion_id": {"$ref": "#/definitions/nullableHex64"},
        "evidence_edge_id": {"$ref": "#/definitions/nullableHex64"},
        "evidence_fragment_ref": {"$ref": "#/definitions/nullableHex64"},
        "expected_active_revision_id": {"$ref": "#/definitions/nullableHex64"}
      }
    },
    "stateDeltaV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta_version", "delta_id", "operation", "object_kind", "object_id", "revision_id",
        "expected_active_revision_id", "envelope_ref", "assertion_id", "evidence_edge_id",
        "evidence_fragment_ref", "deletion_command_id", "scope_digest", "reason_code"
      ],
      "properties": {
        "delta_version": {"const": "1"},
        "delta_id": {"$ref": "#/definitions/hex64"},
        "operation": {"enum": ["ADD", "RETRACT", "TOMBSTONE"]},
        "object_kind": {"enum": ["MEMORY_REVISION", "EVIDENCE_FRAGMENT", "ASSERTION", "EVIDENCE_EDGE"]},
        "object_id": {"$ref": "#/definitions/hex64"},
        "revision_id": {"$ref": "#/definitions/nullableHex64"},
        "expected_active_revision_id": {"$ref": "#/definitions/nullableHex64"},
        "envelope_ref": {"$ref": "#/definitions/nullableHex64"},
        "assertion_id": {"$ref": "#/definitions/nullableHex64"},
        "evidence_edge_id": {"$ref": "#/definitions/nullableHex64"},
        "evidence_fragment_ref": {"$ref": "#/definitions/nullableHex64"},
        "deletion_command_id": {"$ref": "#/definitions/nullableHex64"},
        "scope_digest": {"$ref": "#/definitions/nullableHex64"},
        "reason_code": {"$ref": "#/definitions/safeReasonCode"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "changeset_id",
    "workspace_id",
    "parent_generation_id",
    "expected_active_revisions",
    "command_ids",
    "deltas",
    "changes_root"
  ],
  "properties": {
    "contract_version": {"const": "wiki-encrypted-accepted-change-set-v1"},
    "changeset_id": {"$ref": "#/definitions/hex64"},
    "workspace_id": {"$ref": "#/definitions/opaqueId"},
    "parent_generation_id": {"$ref": "#/definitions/nullableHex64"},
    "expected_active_revisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/expectedActiveRevisionV1"}
    },
    "command_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/hex64"}
    },
    "deltas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/stateDeltaV1"}
    },
    "changes_root": {"$ref": "#/definitions/hex64"}
  }
}
