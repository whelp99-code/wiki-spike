{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wiki-spike.local/schemas/encrypted-lifecycle/binding-registry-checkpoint-v1.schema.json",
  "title": "Binding Registry Checkpoint v1 (Stage 8 frozen binding authority wire)",
  "description": "SignedBindingRegistryCheckpointV1 = {checkpoint,checkpoint_signature}. BindingRegistryCheckpointV1 binds veto_set_size/veto_set_root and transition_size/transition_root together with history_size/history_root and current_map_root; generation/veto/transition commitments must equal the signed generation and accepted floor candidate. First checkpoint has null prior_checkpoint_hash; later checkpoints point to SHA-256 of the prior canonical checkpoint bytes. Signature input under R10-2 is domain `wiki.binding.checkpoint.v1\\0` + canonical payload bytes (Stage 8 wrapper-object framing is struck).",
  "definitions": {
    "decimalString": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex128": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "opaqueId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "nullableHex64": {"oneOf": [{"$ref": "#/definitions/hex64"}, {"type": "null"}]}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpoint", "checkpoint_signature"],
  "properties": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "workspace_id", "generation_id", "registry_sequence", "history_size", "history_root",
        "current_leaf_count", "current_map_root", "veto_set_size", "veto_set_root", "transition_size",
        "transition_root", "created_at", "prior_checkpoint_hash", "signer_key_id"
      ],
      "properties": {
        "schema": {"const": "wiki-binding-registry-checkpoint-v1"},
        "workspace_id": {"$ref": "#/definitions/opaqueId"},
        "generation_id": {"$ref": "#/definitions/hex64"},
        "registry_sequence": {"$ref": "#/definitions/decimalString"},
        "history_size": {"$ref": "#/definitions/decimalString"},
        "history_root": {"$ref": "#/definitions/hex64"},
        "current_leaf_count": {"$ref": "#/definitions/decimalString"},
        "current_map_root": {"$ref": "#/definitions/hex64"},
        "veto_set_size": {"$ref": "#/definitions/decimalString"},
        "veto_set_root": {"$ref": "#/definitions/hex64"},
        "transition_size": {"$ref": "#/definitions/decimalString"},
        "transition_root": {"$ref": "#/definitions/hex64"},
        "created_at": {"$ref": "#/definitions/timestamp"},
        "prior_checkpoint_hash": {"$ref": "#/definitions/nullableHex64"},
        "signer_key_id": {"type": "string", "minLength": 1}
      }
    },
    "checkpoint_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "algorithm", "key_id", "checkpoint_sha256", "signature"],
      "properties": {
        "schema": {"const": "wiki-binding-registry-checkpoint-signature-v1"},
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "checkpoint_sha256": {"$ref": "#/definitions/hex64"},
        "signature": {"$ref": "#/definitions/hex128"}
      }
    }
  }
}
