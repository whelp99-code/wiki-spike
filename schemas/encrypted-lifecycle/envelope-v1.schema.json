{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wiki-spike.local/schemas/encrypted-lifecycle/envelope-v1.schema.json",
  "title": "Encrypted Lifecycle Envelope v1",
  "description": "Opaque AES-256-GCM canonical artifact envelope. AesGcmNonceHex24 is the only nonce type accepted here; ChallengeNonceHex64 is never a valid substitute (cross-use rejects). `metadata` is a closed non-sensitive declared allowlist only; no free-text, plaintext, or path field may appear.",
  "definitions": {
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "aesGcmNonceHex24": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "envelopeMetadataV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_epoch", "key_version", "content_length_bytes", "created_at"],
      "properties": {
        "consent_epoch": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "key_version": {"$ref": "#/definitions/decimalString"},
        "content_length_bytes": {"$ref": "#/definitions/decimalString"},
        "created_at": {"$ref": "#/definitions/timestamp"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "algorithm",
    "workspace_id",
    "logical_object_id",
    "revision_id",
    "semantic_schema_id",
    "nonce",
    "aad_digest",
    "ciphertext",
    "tag",
    "metadata"
  ],
  "properties": {
    "schema": {"const": "wiki-envelope-v1"},
    "version": {"$ref": "#/definitions/decimalString"},
    "algorithm": {"const": "AES-256-GCM"},
    "workspace_id": {"$ref": "#/definitions/opaqueId"},
    "logical_object_id": {"$ref": "#/definitions/hex64"},
    "revision_id": {"$ref": "#/definitions/hex64"},
    "semantic_schema_id": {"type": "string", "minLength": 1},
    "nonce": {"$ref": "#/definitions/aesGcmNonceHex24"},
    "aad_digest": {"$ref": "#/definitions/hex64"},
    "ciphertext": {"type": "string", "pattern": "^[0-9a-f]*$"},
    "tag": {"$ref": "#/definitions/hex32"},
    "metadata": {"$ref": "#/definitions/envelopeMetadataV1"}
  }
}
