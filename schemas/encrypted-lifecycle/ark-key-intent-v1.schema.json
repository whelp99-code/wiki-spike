{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wiki-spike.local/schemas/encrypted-lifecycle/ark-key-intent-v1.schema.json",
  "title": "Encrypted Lifecycle ARK Key Intent v1",
  "description": "Per-artifact independent ARK (create-only platform/recovery custody) key-intent lifecycle state. `ark_handle` is opaque and carries no semantic meaning. Receipts are null until the corresponding custody/CAS boundary is authenticated; QUARANTINED and ORPHAN_* are reached only through fail-closed corrupt-row-safe reconciliation, never optimistic completion.",
  "definitions": {
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullableHex64": {
      "oneOf": [
        {"$ref": "#/definitions/hex64"},
        {"type": "null"}
      ]
    },
    "arkNamespacesV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_namespace", "recovery_namespace"],
      "properties": {
        "platform_namespace": {"type": "string", "minLength": 1, "maxLength": 256},
        "recovery_namespace": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "arkReceiptsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_receipt_digest", "recovery_receipt_digest", "cas_receipt_digest"],
      "properties": {
        "platform_receipt_digest": {"$ref": "#/definitions/nullableHex64"},
        "recovery_receipt_digest": {"$ref": "#/definitions/nullableHex64"},
        "cas_receipt_digest": {"$ref": "#/definitions/nullableHex64"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent_id",
    "state",
    "ark_handle",
    "workspace_id",
    "artifact_id",
    "revision_id",
    "semantic_digest",
    "aad_digest",
    "namespaces",
    "receipts",
    "updated_at"
  ],
  "properties": {
    "schema": {"const": "wiki-ark-key-intent-v1"},
    "intent_id": {"$ref": "#/definitions/hex64"},
    "state": {
      "enum": [
        "KEY_INTENT_PREPARED",
        "PLATFORM_KEY_VERIFIED",
        "RECOVERY_KEY_VERIFIED",
        "CAS_MATERIALIZED",
        "ACTIVE",
        "ORPHAN_PENDING_DESTROY",
        "ORPHAN_DESTROYED",
        "QUARANTINED"
      ]
    },
    "ark_handle": {"type": "string", "minLength": 1, "maxLength": 256},
    "workspace_id": {"$ref": "#/definitions/opaqueId"},
    "artifact_id": {"$ref": "#/definitions/hex64"},
    "revision_id": {"$ref": "#/definitions/hex64"},
    "semantic_digest": {"$ref": "#/definitions/hex64"},
    "aad_digest": {"$ref": "#/definitions/hex64"},
    "namespaces": {"$ref": "#/definitions/arkNamespacesV1"},
    "receipts": {"$ref": "#/definitions/arkReceiptsV1"},
    "updated_at": {"$ref": "#/definitions/timestamp"}
  }
}
