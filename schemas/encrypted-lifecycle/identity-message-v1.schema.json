{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wiki-spike.local/schemas/encrypted-lifecycle/identity-message-v1.schema.json",
  "title": "Encrypted Lifecycle Identity Messages v1 (Command/Manifest/ArtifactSemantic/LogicalObject/Revision)",
  "description": "Five frozen number-free HMAC identity message shapes (Revision 6/7, restated exact). Each variant is distinguished by its own literal `domain` label and is the exact canonical byte input to its labeled HKDF key HMAC. No JSON numeric tokens are permitted anywhere; all counters/versions are canonical decimal strings.",
  "definitions": {
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "canonicalValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/definitions/canonicalValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/definitions/canonicalValue"}}
      ]
    },
    "commandDigestMessageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "version", "key_version", "workspace_id", "command_kind", "normalized_options", "input_content_digest", "policy_context_digest"],
      "properties": {
        "domain": {"const": "wiki.command"},
        "version": {"const": "1"},
        "key_version": {"const": "1"},
        "workspace_id": {"$ref": "#/definitions/opaqueId"},
        "command_kind": {"enum": ["REMEMBER", "APPROVE", "REJECT", "CORRECT", "FORGET"]},
        "normalized_options": {"type": "object", "additionalProperties": {"$ref": "#/definitions/canonicalValue"}},
        "input_content_digest": {"$ref": "#/definitions/hex64"},
        "policy_context_digest": {"$ref": "#/definitions/hex64"}
      }
    },
    "manifestEntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_role", "ordinal", "artifact_kind", "revision_id", "artifact_semantic_digest"],
      "properties": {
        "artifact_role": {"enum": ["PRIMARY_MEMORY", "EVIDENCE_FRAGMENT", "ASSERTION", "EVIDENCE_EDGE"]},
        "ordinal": {"$ref": "#/definitions/decimalString"},
        "artifact_kind": {"enum": ["MEMORY_REVISION", "EVIDENCE_FRAGMENT", "ASSERTION", "EVIDENCE_EDGE"]},
        "revision_id": {"$ref": "#/definitions/hex64"},
        "artifact_semantic_digest": {"$ref": "#/definitions/hex64"}
      }
    },
    "manifestDigestMessageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "version", "key_version", "workspace_id", "command_digest", "entries"],
      "properties": {
        "domain": {"const": "wiki.command-manifest"},
        "version": {"const": "1"},
        "key_version": {"const": "1"},
        "workspace_id": {"$ref": "#/definitions/opaqueId"},
        "command_digest": {"$ref": "#/definitions/hex64"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/manifestEntryV1"}
        }
      }
    },
    "artifactSemanticMessageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "version", "key_version", "workspace_id", "artifact_kind", "consent_epoch", "semantic_schema", "semantic_plaintext"],
      "properties": {
        "domain": {"const": "wiki.artifact-semantic"},
        "version": {"const": "1"},
        "key_version": {"const": "1"},
        "workspace_id": {"$ref": "#/definitions/opaqueId"},
        "artifact_kind": {"enum": ["MEMORY_REVISION", "EVIDENCE_FRAGMENT", "ASSERTION", "EVIDENCE_EDGE"]},
        "consent_epoch": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "semantic_schema": {"type": "string", "minLength": 1},
        "semantic_plaintext": {"type": "object", "additionalProperties": {"$ref": "#/definitions/canonicalValue"}}
      }
    },
    "logicalObjectIdMessageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "version", "key_version", "workspace_id", "object_kind", "consent_epoch", "subject_key_digest"],
      "properties": {
        "domain": {"const": "wiki.logical-object-id"},
        "version": {"const": "1"},
        "key_version": {"const": "1"},
        "workspace_id": {"$ref": "#/definitions/opaqueId"},
        "object_kind": {"enum": ["MEMORY", "EVIDENCE_FRAGMENT", "ASSERTION", "EVIDENCE_EDGE"]},
        "consent_epoch": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "subject_key_digest": {"$ref": "#/definitions/hex64"}
      }
    },
    "revisionIdMessageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "version", "key_version", "workspace_id", "object_kind", "logical_object_id", "consent_epoch", "revision_number", "parent_revision_id", "artifact_semantic_digest"],
      "properties": {
        "domain": {"const": "wiki.revision-id"},
        "version": {"const": "1"},
        "key_version": {"const": "1"},
        "workspace_id": {"$ref": "#/definitions/opaqueId"},
        "object_kind": {"enum": ["MEMORY", "EVIDENCE_FRAGMENT", "ASSERTION", "EVIDENCE_EDGE"]},
        "logical_object_id": {"$ref": "#/definitions/hex64"},
        "consent_epoch": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "revision_number": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "parent_revision_id": {
          "oneOf": [
            {"$ref": "#/definitions/hex64"},
            {"type": "null"}
          ]
        },
        "artifact_semantic_digest": {"$ref": "#/definitions/hex64"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/commandDigestMessageV1"},
    {"$ref": "#/definitions/manifestDigestMessageV1"},
    {"$ref": "#/definitions/artifactSemanticMessageV1"},
    {"$ref": "#/definitions/logicalObjectIdMessageV1"},
    {"$ref": "#/definitions/revisionIdMessageV1"}
  ]
}
