{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-spike.local/schemas/second-brain/unified-db-export-only-authorization-v1.schema.json",
  "title": "Second Brain Unified-DB Export-Only Authorization V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_version",
    "authorization_kind",
    "authorization_id",
    "nonce",
    "source_name",
    "operation",
    "profile_digest",
    "plan_digest",
    "mapping_digest",
    "adapter_digest",
    "inventory_digest",
    "destination_digest",
    "quiesce_approved",
    "max_exports",
    "source_body_read_allowed_for_export",
    "mutation_allowed",
    "import_allowed",
    "register_allowed",
    "cohort_allowed",
    "serve_allowed",
    "promote_allowed",
    "cutover_allowed",
    "issued_at",
    "not_before",
    "expires_at",
    "authorization_digest"
  ],
  "properties": {
    "authorization_version": {
      "const": "second-brain-unified-db-export-only-authorization-v1"
    },
    "authorization_kind": {
      "const": "LIVE_EXPORT_ONLY"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonce": {
      "$ref": "#/$defs/sha256"
    },
    "source_name": {
      "const": "unified-db"
    },
    "operation": {
      "const": "EXPORT_ONLY"
    },
    "profile_digest": {
      "$ref": "#/$defs/sha256"
    },
    "plan_digest": {
      "$ref": "#/$defs/sha256"
    },
    "mapping_digest": {
      "$ref": "#/$defs/sha256"
    },
    "adapter_digest": {
      "$ref": "#/$defs/sha256"
    },
    "inventory_digest": {
      "$ref": "#/$defs/sha256"
    },
    "destination_digest": {
      "$ref": "#/$defs/sha256"
    },
    "quiesce_approved": {
      "const": true
    },
    "max_exports": {
      "const": "1"
    },
    "source_body_read_allowed_for_export": {
      "const": true
    },
    "mutation_allowed": {
      "const": false
    },
    "import_allowed": {
      "const": false
    },
    "register_allowed": {
      "const": false
    },
    "cohort_allowed": {
      "const": false
    },
    "serve_allowed": {
      "const": false
    },
    "promote_allowed": {
      "const": false
    },
    "cutover_allowed": {
      "const": false
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "not_before": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "authorization_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
