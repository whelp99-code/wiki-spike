{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-spike.local/schemas/second-brain/unified-db-export-proof-v1.schema.json",
  "title": "Second Brain Unified-DB Export Read-Safety Proof V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proof_version",
    "phase",
    "isolation",
    "read_only",
    "deferrable",
    "writer_count",
    "db_commitment",
    "catalog_commitment",
    "source_commitment",
    "data_root_commitment",
    "proof_digest"
  ],
  "properties": {
    "proof_version": {
      "const": "second-brain-unified-db-export-read-safety-proof-v1"
    },
    "phase": {
      "enum": ["OPENING", "CLOSING"]
    },
    "isolation": {
      "const": "SERIALIZABLE"
    },
    "read_only": {
      "const": true
    },
    "deferrable": {
      "const": true
    },
    "writer_count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "db_commitment": {
      "$ref": "#/$defs/sha256"
    },
    "catalog_commitment": {
      "$ref": "#/$defs/sha256"
    },
    "source_commitment": {
      "$ref": "#/$defs/sha256"
    },
    "data_root_commitment": {
      "$ref": "#/$defs/sha256"
    },
    "proof_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
