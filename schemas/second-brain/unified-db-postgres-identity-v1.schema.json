{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-spike.local/schemas/second-brain/unified-db-postgres-identity-v1.schema.json",
  "title": "Second Brain Unified-DB PostgreSQL Identity V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_version",
    "source_name",
    "system_identifier",
    "database_oid",
    "server_version_num",
    "catalog_digest",
    "capture_method",
    "capture_version",
    "captured_at",
    "identity_digest"
  ],
  "properties": {
    "identity_version": {
      "const": "second-brain-unified-db-postgres-identity-v1"
    },
    "source_name": {
      "const": "unified-db"
    },
    "system_identifier": {
      "$ref": "#/$defs/canonicalDecimal"
    },
    "database_oid": {
      "$ref": "#/$defs/canonicalDecimal"
    },
    "server_version_num": {
      "$ref": "#/$defs/canonicalDecimal"
    },
    "catalog_digest": {
      "$ref": "#/$defs/sha256"
    },
    "capture_method": {
      "const": "owner-produced-body-free"
    },
    "capture_version": {
      "const": "second-brain-unified-db-postgres-identity-capture-v1"
    },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identity_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
