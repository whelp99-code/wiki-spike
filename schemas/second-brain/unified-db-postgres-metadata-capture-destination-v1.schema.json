{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki-spike.local/schemas/second-brain/unified-db-postgres-metadata-capture-destination-v1.schema.json",
  "title": "Second Brain Unified-DB Postgres Metadata Capture Destination V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "destination_version",
    "source_name",
    "operation",
    "authorization_kind",
    "destination_path",
    "path_policy",
    "import_requested",
    "serve_requested",
    "promote_requested",
    "cutover_requested",
    "destination_digest"
  ],
  "properties": {
    "destination_version": {
      "const": "second-brain-unified-db-postgres-metadata-capture-destination-v1"
    },
    "source_name": {
      "const": "unified-db"
    },
    "operation": {
      "const": "METADATA_CAPTURE_ONLY"
    },
    "authorization_kind": {
      "const": "POSTGRES_METADATA_CAPTURE_ONLY"
    },
    "destination_path": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/[^\\u0000-\\u001F\\u007F]+$"
    },
    "path_policy": {
      "const": "create-only-exclusive"
    },
    "import_requested": {
      "const": false
    },
    "serve_requested": {
      "const": false
    },
    "promote_requested": {
      "const": false
    },
    "cutover_requested": {
      "const": false
    },
    "destination_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
